{
  "name": "Cyberpunk TCG - Test",
  "menuBackgroundImage": "https://cdn.imgchest.com/files/6770d283485d.jpg",
  "defaultRessources": {
    "backgrounds": [
      "https://cdn.imgchest.com/files/b0694adbd19a.jpg",
      "https://cdn.imgchest.com/files/80605045da94.jpg",
      "https://cdn.imgchest.com/files/c33a2852e8fc.jpg"
    ],
    "decksUrl": "https://russeus.github.io/CyberpunkTCG-TCGA/Cyberpunk-TCG-Decks.json"
  },
  "customHelp": "(1) Legends are already shuffled at the start of a game.\n(2) Resources will be auto paid if you put a card on the Field or on the Stack (right zone, above the chat). If you want to pay your resources manually, you can deactivate the autopay feature on the Preferences button on the left menu.\n(3) When you put a card on your Eddies zone, you don't need to reveal it to your opponent, it will be visible in the logs.\n(4) To roll a Gig, use the 'Roll a dice' button on the left menu, then you can enter the number on the fields over each dice. Right are friendly Gigs, left are Rival Gigs.\n(5) You can peek a hidden card with context menu 'Visible by' -> 'Only You' and then hide it to 'All'.\n(6) While you hold 'G', you can click on a Gear and the on a Unit to attach it. You can use contex menu also.\n(7) You can quickly discard cards with 'D + click'\n(8) Use 'Ctrl + C + click' or 'C + click' to add counters to cards and manage their Power.\n(9) You can play with yourself by opening another tab and use your own code to connect with yourself.\n\nThis project is not affiliated with Cyberpunk TCG, WeirdCo or CD Projekt Red.",
  "cardRotation": "90",
  "cards": {
    "dataUrl": "https://russeus.github.io/CyberpunkTCG-TCGA/Test/Cyberpunk-TCG-Cards.json",
    "cardBack": "https://i.postimg.cc/NMZyFHJM/CPTCG-card-Back.png",
    "extraCardBacks": {
      "Legend": "https://i.postimg.cc/7ZPQmG94/CPTCG-Card-Back-Legend.png"
    }
  },
  "deckBuilding": {
    "mainFilters": [
      "type",
      "cost",
      "name",
      "RAM Color"
    ],
    "formats": [
      {
        "title": "Classic",
        "gameplay": "Classic",
        "customCategories": []
      }
    ]
  },
  "gameplay": {
    "Classic": {
      "mulligan": {
        "info": "If you want, you can shuffle your hand back into your deck and draw 6 new cards, but only once.",
        "startingHandSize": "0",
        "drawNewHand": true,
        "putSelectionAtBottom": false,
        "drawNewSelectedCards": false
      },
      "newTurn": {
        "drawOnStart": false,
        "sharedTurn": false,
        "firstPlayerTokenName": "",
        "drawPerTurn": 1
      },
      "defaultNotes": "",
      "tokens": [],
      "countersStartingValues": [],
      "hideFacedDownCards": true,
      "sections": {
        "layout": {
          "direction": "column",
          "isSymetricalForOpponents": false,
          "content": [
            {
              "section": "Field",
              "style": {
                "marginTop": "3.5vh"
              }
            },
            {
              "section": "Mana"
            },
            {
              "section": "Gigs"
            }
          ]
        },
        "categoriesAlreadyOnBoard": [
          "Legend->Mana"
        ],
        "autoPlayFromHand": {
          "Program": "Stack",
          "Gear": "Stack",
          "Legend": "Field",
          "Unit": "Field"
        },
        "autoPlayFromStack": {
          "Program": "Discard",
          "Gear": "GROUP",
          "Legend": "Field",
          "Unit": "Field"
        },
        "sectionsDict": {
          "Field": {
            "title": "Field",
            "isHidden": "no",
            "height": "MEDIUM",
            "alignment": "CENTER",
            "isHorizontalAllowed": true,
            "displayedTitle": "",
            "reverseZOrder": true
          },
          "Mana": {
            "title": "Mana",
            "isHidden": "yes",
            "height": "SMALL",
            "alignment": "START",
            "noAutoPayTo": true,
            "isHorizontalAllowed": true,
            "displayedTitle": "Eddies",
            "startsShuffled": true,
            "showHiddenCardInHistory": true
          },
          "Gigs": {
            "type": "custom",
            "isShared": true,
            "defaultValue": {
              "0": [
                {
                  "dice": 4,
                  "value": 0,
                  "stolen": false
                },
                {
                  "dice": 6,
                  "value": 0,
                  "stolen": false
                },
                {
                  "dice": 8,
                  "value": 0,
                  "stolen": false
                },
                {
                  "dice": 10,
                  "value": 0,
                  "stolen": false
                },
                {
                  "dice": 12,
                  "value": 0,
                  "stolen": false
                },
                {
                  "dice": 20,
                  "value": 0,
                  "stolen": false
                }
              ],
              "1": [
                {
                  "dice": 4,
                  "value": 0,
                  "stolen": false
                },
                {
                  "dice": 6,
                  "value": 0,
                  "stolen": false
                },
                {
                  "dice": 8,
                  "value": 0,
                  "stolen": false
                },
                {
                  "dice": 10,
                  "value": 0,
                  "stolen": false
                },
                {
                  "dice": 12,
                  "value": 0,
                  "stolen": false
                },
                {
                  "dice": 20,
                  "value": 0,
                  "stolen": false
                }
              ],
              "totals": {
                "0": 0,
                "1": 0
              },
              "hasRolled": false
            },
            "blueprint": {
              "type": "div",
              "props": {
                "className": "d-flex flex-column justify-content-between position-fixed start-50 top-50 translate-middle",
                "style": {
                  "--gigs-width": "7vh",
                  "--gigs-font-weight": "700",
                  "--gigs-font-size": "1.7vh",
                  "--gigs-blue": "#64bfe3",
                  "--gigs-red": "#d83938",
                  "--gigs-opacity": "0.3",
                  "--gigs-padding": "0.7vh 0",
                  "height": "10vh",
                  "width": "115vh",
                  "backdropFilter": "blur(20px)",
                  "padding": "0.5vh",
                  "backgroundColor": "#202020c9",
                  "borderRadius": "0.5vh",
                  "marginLeft": "var(--left-offset-centered)"
                }
              },
              "children": [
                {
                  "type": "div",
                  "props": {
                    "className": "d-flex gap-3"
                  },
                  "children": [
                    {
                      "type": "div",
                      "props": {
                        "className": "d-flex ",
                        "style": {
                          "marginRight": "auto"
                        }
                      },
                      "children": [
                        {
                          "type": "loop",
                          "iterable": "game.data.Gigs[(game.turn.orderPosition + 1) % 2]",
                          "template": {
                            "type": "div",
                            "props": {
                              "className": "position-relative on-section-hovered",
                              "style": {
                                "width": "var(--gigs-width)",
                                "pointerEvents": "{{item.stolen || item.value === 0 ? 'none' : 'auto'}}"
                              }
                            },
                            "children": [
                              {
                                "type": "input-number",
                                "props": {
                                  "value": "{{item.value}}",
                                  "readOnly": true,
                                  "type": "number",
                                  "style": {
                                    "backgroundColor": "transparent",
                                    "background": "url(https://russeus.github.io/CyberpunkTCG-TCGA/Images/Blue/d{{item.dice}}.png) center / contain no-repeat",
                                    "textAlign": "center",
                                    "color": "{{item.value > 0 && !item.stolen ? 'var(--gigs-blue)' : 'transparent'}}",
                                    "opacity": "{{item.stolen ? 'var(--gigs-opacity)' : '1'}}",
                                    "fontSize": "var(--gigs-font-size)",
                                    "fontWeight": "var(--gigs-font-weight)",
                                    "padding": "var(--gigs-padding)"
                                  }
                                }
                              },
                              {
                                "type": "button",
                                "props": {
                                  "className": "hovered-reveal position-absolute top-0 start-50",
                                  "style": {
                                    "translate": "-50% -90%"
                                  }
                                },
                                "children": "Steal",
                                "onClick": "game.data.Gigs[(game.turn.orderPosition + 1) % 2][index].stolen = true"
                              }
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "type": "div",
                      "props": {
                        "className": "d-flex ",
                        "style": {
                          "marginLeft": "auto"
                        }
                      },
                      "children": [
                        {
                          "type": "loop",
                          "iterable": "game.data.Gigs[game.turn.orderPosition]",
                          "template": {
                            "type": "div",
                            "props": {
                              "className": "position-relative on-section-hovered",
                              "style": {
                                "width": "var(--gigs-width)",
                                "pointerEvents": "{{item.stolen && item.value !== 0 ? 'auto' : 'none'}}"
                              }
                            },
                            "children": [
                              {
                                "type": "input-number",
                                "props": {
                                  "value": "{{item.value}}",
                                  "type": "number",
                                  "readOnly": true,
                                  "style": {
                                    "backgroundColor": "transparent",
                                    "background": "url(https://russeus.github.io/CyberpunkTCG-TCGA/Images/Red/d{{item.dice}}.png) center / contain no-repeat",
                                    "textAlign": "center",
                                    "color": "{{item.value > 0 && item.stolen ? 'var(--gigs-red)' : 'transparent'}}",
                                    "opacity": "{{item.stolen ? '1' : 'var(--gigs-opacity)'}}",
                                    "fontSize": "var(--gigs-font-size)",
                                    "fontWeight": "var(--gigs-font-weight)",
                                    "padding": "var(--gigs-padding)"
                                  }
                                }
                              },
                              {
                                "type": "button",
                                "props": {
                                  "className": "hovered-reveal position-absolute top-0 start-50",
                                  "style": {
                                    "translate": "-50% -90%"
                                  }
                                },
                                "children": "Steal",
                                "onClick": "game.data.Gigs[game.turn.orderPosition][index].stolen = false"
                              }
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "type": "div",
                      "props": {
                        "className": "d-flex align-items-center justify-content-center",
                        "style": {
                          "color": "var(--gigs-red)",
                          "fontSize": "var(--gigs-font-size)",
                          "fontWeight": "var(--gigs-font-weight)",
                          "width": "var(--gigs-width)"
                        }
                      },
                      "children": "{{game.data.Gigs.totals[(game.turn.orderPosition + 1) % 2]}}"
                    }
                  ]
                },
                {
                  "type": "div",
                  "props": {
                    "className": "d-flex gap-3"
                  },
                  "children": [
                    {
                      "type": "div",
                      "props": {
                        "className": "d-flex ",
                        "style": {
                          "marginRight": "auto"
                        }
                      },
                      "children": [
                        {
                          "type": "loop",
                          "iterable": "game.data.Gigs[(game.turn.orderPosition + 1) % 2]",
                          "template": {
                            "type": "div",
                            "props": {
                              "className": "position-relative on-section-hovered",
                              "style": {
                                "width": "var(--gigs-width)",
                                "pointerEvents": "{{item.stolen ? 'auto' : 'none'}}"
                              }
                            },
                            "children": [
                              {
                                "type": "input-number",
                                "props": {
                                  "value": "{{item.value}}",
                                  "type": "number",
                                  "style": {
                                    "backgroundColor": "transparent",
                                    "background": "url(https://russeus.github.io/CyberpunkTCG-TCGA/Images/Red/d{{item.dice}}.png) center / contain no-repeat",
                                    "textAlign": "center",
                                    "color": "{{item.value > 0 && item.stolen ? 'var(--gigs-red)' : 'transparent'}}",
                                    "opacity": "{{item.stolen ? '1' : 'var(--gigs-opacity)'}}",
                                    "fontSize": "var(--gigs-font-size)",
                                    "fontWeight": "var(--gigs-font-weight)",
                                    "padding": "var(--gigs-padding)"
                                  }
                                },
                                "onChange": "game.data.Gigs[(game.turn.orderPosition + 1) % 2][index].value = delta"
                              },
                              {
                                "type": "button",
                                "props": {
                                  "className": "hovered-reveal position-absolute top-100 start-50",
                                  "style": {
                                    "translate": "-50% -10%"
                                  }
                                },
                                "children": "Roll",
                                "onClick": "game.data.Gigs[(game.turn.orderPosition + 1) % 2][index].value = Math.floor(Math.random() * game.data.Gigs[(game.turn.orderPosition + 1) % 2][index].dice) + 1; game.data.Gigs.hasRolled = true"
                              }
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "type": "div",
                      "props": {
                        "className": "position-relative h-100"
                      },
                      "children": [
                        {
                          "type": "div",
                          "props": {
                            "className": "box-container position-absolute start-50 top-50 translate-middle text-nowrap m-0",
                            "style": {
                              "opacity": "{{game.turn.isMyTurn && !game.data.Gigs.hasRolled ? 1 : 0}}"
                            }
                          },
                          "children": "Don't forget to roll!"
                        }
                      ]
                    },
                    {
                      "type": "div",
                      "props": {
                        "className": "d-flex ",
                        "style": {
                          "marginLeft": "auto"
                        }
                      },
                      "children": [
                        {
                          "type": "loop",
                          "iterable": "game.data.Gigs[game.turn.orderPosition]",
                          "template": {
                            "type": "div",
                            "props": {
                              "className": "position-relative on-section-hovered",
                              "style": {
                                "width": "var(--gigs-width)",
                                "pointerEvents": "{{item.stolen ? 'none' : 'auto'}}"
                              }
                            },
                            "children": [
                              {
                                "type": "input-number",
                                "props": {
                                  "value": "{{item.value}}",
                                  "type": "number",
                                  "style": {
                                    "backgroundColor": "transparent",
                                    "background": "url(https://russeus.github.io/CyberpunkTCG-TCGA/Images/Blue/d{{item.dice}}.png) center / contain no-repeat",
                                    "textAlign": "center",
                                    "color": "{{item.value > 0 && !item.stolen ? 'var(--gigs-blue)' : 'transparent'}}",
                                    "opacity": "{{item.stolen ? 'var(--gigs-opacity)' : '1'}}",
                                    "fontSize": "var(--gigs-font-size)",
                                    "fontWeight": "var(--gigs-font-weight)",
                                    "padding": "var(--gigs-padding)"
                                  }
                                },
                                "onChange": "game.data.Gigs[game.turn.orderPosition][index].value = delta"
                              },
                              {
                                "type": "button",
                                "props": {
                                  "className": "hovered-reveal position-absolute top-100 start-50",
                                  "style": {
                                    "translate": "-50% -10%"
                                  }
                                },
                                "children": "Roll",
                                "onClick": "game.data.Gigs[game.turn.orderPosition][index].value = Math.floor(Math.random() * game.data.Gigs[game.turn.orderPosition][index].dice) + 1; game.data.Gigs.hasRolled = true; chatLog(`Rolled ` + game.data.Gigs[game.turn.orderPosition][index].value)"
                              }
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "type": "div",
                      "props": {
                        "className": "d-flex align-items-center justify-content-center",
                        "style": {
                          "color": "var(--gigs-blue)",
                          "fontSize": "var(--gigs-font-size)",
                          "fontWeight": "var(--gigs-font-weight)",
                          "width": "var(--gigs-width)"
                        }
                      },
                      "children": "{{game.data.Gigs.totals[game.turn.orderPosition]}}"
                    }
                  ]
                }
              ]
            },
            "events": {
              "onUpdate": "let t=[0,0]; [0,1].forEach(i=>{ (game.data.Gigs[i]||[]).forEach(item=>{ t[item.stolen?1-i:i]+=(Number(item.value)||0); }); }); game.data.Gigs.totals=t;",
              "onOpponentUpdate": "const gigs=game.data.Gigs; const oppGigs=opponentGame.data.Gigs; const clean=obj=>JSON.stringify(obj,(k,v)=>k==='_refresh'?undefined:v); [0,1].forEach(i=>{ if(clean(gigs[i])!==clean(oppGigs[i])){ gigs[i]=oppGigs[i]; } });",
              "onNewTurn": "game.data.Gigs.hasRolled = false"
            }
          }
        }
      }
    }
  }
}